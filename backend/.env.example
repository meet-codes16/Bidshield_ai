APP_NAME=BidShield_AI
# Default local SQLite database (ready out-of-the-box):
DATABASE_URL=sqlite:///./iprocurement_demo.db
# For Docker PostgreSQL deployment, uncomment:
# DATABASE_URL=postgresql+psycopg://iprocurement:iprocurement@postgres:5432/iprocurement

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=iprocurement

JWT_SECRET=local-demo-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Provide your Groq API key to enable live LLM evidence analysis:
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
MOCK_LLM=false

VECTOR_DB_URL=
MAX_UPLOAD_SIZE=26214400
UPLOAD_DIR=data/uploads
EXTRACTED_DIR=data/extracted
AUDIT_DB=data/audit.db

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

STORAGE_MODE=local
AUTHORITY_MODE=mock
EMBEDDING_MODE=local
WORKER_MODE=inline
